# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/stock_screener

# BSE / Twelve Data
TWELVE_DATA_API_KEY=your_twelve_data_key

# SEC EDGAR requires an identifying User-Agent with a real contact email.
# No SEC API key is required.
SEC_USER_AGENT=StockScreener/2.0 your-email@example.com

# Optional automatic refresh. No CSV upload is required.
# Format: EXCHANGE:SYMBOL,EXCHANGE:SYMBOL
AUTO_REFRESH_SYMBOLS=US:AAPL,NSE:RELIANCE,BSE:INFY
AUTO_REFRESH_HOURS=6

# Kotak Neo (Indian stocks only) - credentials are intentionally not stored in source.
# Fill these only after the client provides the account/API setup.
KOTAK_NEO_API_KEY=
KOTAK_NEO_ACCESS_TOKEN=
KOTAK_NEO_BASE_URL=
