# REQUIRED: Railway/PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# REQUIRED for SEC EDGAR: identifiable application + real contact email
SEC_USER_AGENT=StockScreener/2.0 your-email@example.com

# Optional provider/configuration values
TWELVE_DATA_API_KEY=
SEC_CIK_OVERRIDES=

# Optional automatic refresh list. Format MUST be EXCHANGE:SYMBOL.
AUTO_REFRESH_SYMBOLS=US:AAPL,US:MSFT,NSE:INFY,NSE:RELIANCE
AUTO_REFRESH_HOURS=6

# Background enrichment. Jobs are intentionally delayed after a cold start so
# they do not compete with the first client dashboard requests.
RS_BACKFILL_ENABLED=true
RS_BACKFILL_BATCH_SIZE=25
RS_BACKFILL_INTERVAL_MINUTES=10
FUNDAMENTAL_BACKFILL_ENABLED=true
FUNDAMENTAL_BACKFILL_BATCH_SIZE=8
FUNDAMENTAL_BACKFILL_INTERVAL_MINUTES=10

# Optional Kotak Neo integration for Indian live market data
KOTAK_NEO_API_KEY=
KOTAK_NEO_ACCESS_TOKEN=
KOTAK_NEO_BASE_URL=
